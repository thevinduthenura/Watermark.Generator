# Supabase Configuration (Optional - without these, app operates in repo-template mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Base Path (Optional - used when hosted at a subpath on GitHub Pages, e.g. /Watermark.Generator)
# Leave blank when using custom domain or root path
NEXT_PUBLIC_BASE_PATH=
